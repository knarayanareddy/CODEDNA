#!/bin/bash
# CodeDNA pre-commit hook
# Per design doc §6.2: exits 0 on any CodeDNA error (C9 - never block workflow)

set -e

DAEMON_URL="${CODEDNA_DAEMON_URL:-http://127.0.0.1:7842}"
CLIENT_HEADER="X-CodeDNA-Client: pre-commit-hook"
MAX_FILE_SIZE=1048576  # 1MB

check_daemon() {
    if ! curl -s --connect-timeout 2 -H "$CLIENT_HEADER" "$DAEMON_URL/health" > /dev/null 2>&1; then
        return 1
    fi
    return 0
}

get_staged_files() {
    git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py)$' || true
}

scan_file() {
    local file_path="$1"
    local content
    
    # Check file size
    local file_size=$(stat -f%z "$file_path" 2>/dev/null || stat -c%s "$file_path" 2>/dev/null || echo 0)
    if [ "$file_size" -gt "$MAX_FILE_SIZE" ]; then
        echo "  [SKIPPED] $file_path (too large: $file_size bytes)"
        return 0
    fi
    
    # Read file content
    content=$(cat "$file_path" 2>/dev/null)
    if [ -z "$content" ]; then
        echo "  [SKIPPED] $file_path (empty or unreadable)"
        return 0
    fi
    
    # Get the repo ID from codedna config
    local repo_id=$(codedna config get default_repo_id 2>/dev/null || echo "")
    if [ -z "$repo_id" ]; then
        echo "  [SKIPPED] $file_path (no repo configured)"
        return 0
    fi
    
    # Call the scan API
    local response
    response=$(curl -s --connect-timeout 5 -X POST \
        -H "$CLIENT_HEADER" \
        -H "Content-Type: application/json" \
        -d "{\"repo_id\":\"$repo_id\",\"file_path\":\"$file_path\",\"language\":\"python\"}" \
        "$DAEMON_URL/api/v1/scan/file" 2>/dev/null)
    
    if [ $? -eq 0 ]; then
        local score=$(echo "$response" | python3 -c "import sys, json; d=json.load(sys.stdin); print(d.get('dna_score', 'N/A'))" 2>/dev/null || echo "N/A")
        if [ "$score" != "N/A" ] && [ "$score" != "null" ]; then
            local pct=$(echo "$score * 100" | python3 -c "import sys; print(f'{float(sys.stdin.read()):.0f}')" 2>/dev/null || echo "?")
            echo "  ✓ $file_path: ${pct}% style match"
        else
            echo "  - $file_path: scan completed (no baseline)"
        fi
    else
        echo "  - $file_path: scan failed (daemon error)"
    fi
}

main() {
    echo "CodeDNA: Scanning staged changes..."
    
    if ! check_daemon; then
        echo "CodeDNA: Skipping scan (daemon unavailable)"
        exit 0
    fi
    
    files=$(get_staged_files)
    if [ -z "$files" ]; then
        echo "CodeDNA: No Python files to scan"
        exit 0
    fi
    
    local file_count=0
    local scan_count=0
    
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        file_count=$((file_count + 1))
        
        # Get the staged content (from index, not working directory)
        staged_content=$(git show ":$file" 2>/dev/null)
        if [ -z "$staged_content" ]; then
            echo "  [SKIPPED] $file (not in index)"
            continue
        fi
        
        scan_count=$((scan_count + 1))
        
        # Create a temporary file for scanning
        tmp_file=$(mktemp)
        echo "$staged_content" > "$tmp_file"
        
        scan_file "$tmp_file"
        
        rm -f "$tmp_file"
    done <<< "$files"
    
    echo ""
    echo "CodeDNA: Scanned $scan_count of $file_count files"
    
    # Per C9: Exit 0 regardless of scan results (never block workflow)
    exit 0
}

main "$@"